root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

# 999 = 사실상 무제한, none.* = 예외 패키지 없음 → 와일드카드 import 금지
ij_kotlin_name_count_to_use_star_import = 999
ij_kotlin_name_count_to_use_star_import_for_members = 999
ij_kotlin_packages_to_use_import_on_demand = none.*

[*.xml]
indent_style = space
indent_size = 4

[*.bat]
# 전역 규칙 예외 — Windows 배치 파일은 CRLF 필수
end_of_line = crlf

[*.properties]
max_line_length = off
ij_properties_spaces_around_key_value_delimiter = false
ij_properties_keep_blank_lines = true

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2
ij_yaml_spaces_within_brackets = false

[*.md]
indent_style = space
indent_size = 2
max_line_length = off
# 전역 규칙 예외 — 줄 끝 공백 2개가 마크다운 강제 개행
trim_trailing_whitespace = false
ij_markdown_wrap_text_if_long = false
ij_markdown_format_tables = false
